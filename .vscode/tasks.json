		{
			"label": "NewMe: Prepare Local SDK",
			"type": "shell",
			"command": "& { $ErrorActionPreference = 'Stop'; $tools = Join-Path $env:LOCALAPPDATA 'NewMeTools'; $env:JAVA_HOME = (Get-ChildItem $tools -Directory -Filter 'jdk-17*' | Select-Object -First 1).FullName; $env:JAVA_TOOL_OPTIONS = '-Djavax.net.ssl.trustStoreType=Windows-ROOT -Djavax.net.ssl.trustStore=NONE'; $response = Invoke-WebRequest -UseBasicParsing 'https://dl.google.com/android/repository/repository2-1.xml'; $text = if ($response.Content -is [byte[]]) { [Text.Encoding]::UTF8.GetString($response.Content) } else { $response.Content }; [xml]$repository = $text; $package = $repository.SelectNodes('//*[local-name()=''remotePackage'' and starts-with(@path,''cmdline-tools;'')]') | Sort-Object { [int]$_.revision.major } -Descending | Select-Object -First 1; $archive = $package.SelectSingleNode('.//*[local-name()=''archive'' and *[local-name()=''host-os'']=''windows'']/*[local-name()=''complete'']'); $zip = Join-Path $tools $archive.url; $expected = $archive.SelectSingleNode('./*[local-name()=''checksum'']').InnerText.Trim(); $algorithm = switch ($expected.Length) { 40 { 'SHA1' } 64 { 'SHA256' } default { throw 'Unsupported published Android checksum' } }; if ((Get-FileHash $zip -Algorithm $algorithm).Hash.ToLowerInvariant() -ne $expected.ToLowerInvariant()) { throw 'Android tools checksum mismatch' }; $sdk = Join-Path $env:LOCALAPPDATA 'Android\\Sdk'; $cli = Join-Path $sdk 'cmdline-tools\\latest'; $manager = Join-Path $cli 'bin\\sdkmanager.bat'; if (-not (Test-Path $manager)) { $extract = Join-Path $tools 'android-cli'; Expand-Archive $zip -DestinationPath $extract -Force; New-Item -ItemType Directory -Path (Join-Path $sdk 'cmdline-tools') -Force | Out-Null; Move-Item (Join-Path $extract 'cmdline-tools') $cli }; $env:ANDROID_HOME = $sdk; & $manager --sdk_root=$sdk --list | Select-String 'platforms;android-36|build-tools;36|platform-tools' }",
			"isBackground": false,
			"problemMatcher": []
		},
