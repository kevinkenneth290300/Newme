<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Stylized modern "N" transformation crest with ascending momentum arrows -->
    <!-- Left vertical bar -->
    <path
        android:pathData="M34,74 L34,34 L43,34 L43,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="74"
                android:endX="43"
                android:endY="34"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6B00" />
                <item android:offset="1.0" android:color="#FFA600" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diagonal dynamic slash with glow -->
    <path
        android:pathData="M37,34 L43,34 L71,70 L71,74 L65,74 L37,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="34"
                android:endX="71"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFA600" />
                <item android:offset="1.0" android:color="#FF4500" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right vertical bar -->
    <path
        android:pathData="M65,74 L65,34 L74,34 L74,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="65"
                android:startY="74"
                android:endX="74"
                android:endY="34"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3D00" />
                <item android:offset="1.0" android:color="#FF9100" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ascending Momentum Arrow Crest on top right -->
    <path
        android:pathData="M74,34 L82,34 L82,24 L72,24 L72,29 L77,29 L68,38 L72,42 L79,35 L79,34 Z"
        android:fillColor="#00E5FF" />
</vector>
